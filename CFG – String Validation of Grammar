#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i, j, n, zeros = 0, valid = 1;

    printf("Enter string: ");
    scanf("%s", s);

    n = strlen(s);

    while (zeros < n && s[zeros] == '0')
        zeros++;

    j = n - zeros;

    for (i = zeros; i < j; i++) {
        if (s[i] != '1')
            valid = 0;
    }

    for (i = 0; i < zeros; i++) {
        if (s[i] != s[n-i-1])
            valid = 0;
    }

    if (valid)
        printf("Accepted");
    else
        printf("Rejected");

    return 0;
}
