#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i, n, valid = 1;

    printf("Enter string: ");
    scanf("%s", s);

    n = strlen(s);

    if (n < 2 || s[0] != '0' || s[n-1] != '1')
        valid = 0;

    for (i = 1; i < n-1; i++) {
        if (s[i] != '0' && s[i] != '1')
            valid = 0;
    }

    if (valid)
        printf("Accepted");
    else
        printf("Rejected");

    return 0;
}
